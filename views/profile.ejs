<%- include('base', { title: 'Hồ sơ' }) %>

<!-- Profile Header -->
<div class="fade-up" style="position: relative; padding: clamp(1rem, 1.5vw, 2.5rem) clamp(0.8rem, 1.5vw, 2rem); border-radius: var(--radius); overflow: hidden; margin-bottom: clamp(0.8rem, 1.2vw, 2rem); background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04);">
    <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(255,23,68,0.06), transparent 70%); pointer-events: none;"></div>
    <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: clamp(0.8rem, 1.5vw, 2rem); flex-wrap: wrap;">
        <div style="position: relative;">
            <div style="width: clamp(64px, 8vw, 100px); height: clamp(64px, 8vw, 100px); border-radius: 50%; background: linear-gradient(135deg, #ff1744, #2979ff); display: flex; align-items: center; justify-content: center; font-size: clamp(1.8rem, 3vw, 2.8rem); font-weight: 800; color: white; box-shadow: 0 0 40px rgba(255,23,68,0.15); flex-shrink: 0;">
                <%= user.username[0].toUpperCase() %>
            </div>
            <div style="position: absolute; bottom: 2px; right: 2px; background: var(--neon-green); width: clamp(12px, 1.5vw, 18px); height: clamp(12px, 1.5vw, 18px); border-radius: 50%; border: 2px solid var(--bg-card);"></div>
        </div>
        
        <div style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <h1 style="font-size: clamp(1.1rem, 1.8vw, 1.8rem); font-weight: 800; margin: 0; background: linear-gradient(135deg, #ff1744, #2979ff, #00e5ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    <%= user.username %>
                </h1>
                <% if (user.is_admin) { %>
                    <span class="badge badge-red" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); padding: 0.1rem 0.6rem;"><i class="fas fa-crown"></i> Admin</span>
                <% } else if (user.is_seller) { %>
                    <span class="badge badge-yellow" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); padding: 0.1rem 0.6rem;"><i class="fas fa-store"></i> Seller</span>
                <% } else { %>
                    <span class="badge badge-blue" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); padding: 0.1rem 0.6rem;"><i class="fas fa-user"></i> Thành viên</span>
                <% } %>
            </div>
            <p style="color: var(--text-secondary); font-size: clamp(0.7rem, 0.8vw, 0.9rem); margin: 0.1rem 0 0; word-break: break-all;">
                <i class="fas fa-envelope" style="color: var(--neon-cyan);"></i> <%= user.email %>
            </p>
            <p style="color: var(--text-muted); font-size: clamp(0.55rem, 0.6vw, 0.75rem); margin: 0.1rem 0 0;">
                <i class="fas fa-calendar-alt"></i> Tham gia: <%= new Date(user.created_at).toLocaleDateString('vi-VN') %>
            </p>
        </div>
        
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/auth/change-password" class="btn btn-outline btn-sm" style="padding: clamp(0.3rem, 0.4vw, 0.5rem) clamp(0.8rem, 1vw, 1.2rem); font-size: clamp(0.65rem, 0.7vw, 0.8rem); border-radius: var(--radius-sm);">
                <i class="fas fa-key"></i> Đổi mật khẩu
            </a>
            <a href="/auth/logout" class="btn btn-danger btn-sm" style="padding: clamp(0.3rem, 0.4vw, 0.5rem) clamp(0.8rem, 1vw, 1.2rem); font-size: clamp(0.65rem, 0.7vw, 0.8rem); border-radius: var(--radius-sm);">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="fade-up profile-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: clamp(0.5rem, 0.8vw, 1rem); margin-bottom: clamp(1rem, 1.5vw, 2rem);">
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: clamp(0.6rem, 0.8vw, 1.2rem); border: 1px solid rgba(255,255,255,0.04); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-bottom: 0.2rem;">
            <i class="fas fa-wallet" style="color: var(--neon-green); font-size: clamp(0.8rem, 1vw, 1.1rem);"></i>
            <span class="text-muted" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); text-transform: uppercase; letter-spacing: 0.5px;">Số dư</span>
        </div>
        <div style="font-size: clamp(1rem, 1.5vw, 1.6rem); font-weight: 800; color: var(--neon-green);"><%= formatPrice(user.balance) %></div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: clamp(0.6rem, 0.8vw, 1.2rem); border: 1px solid rgba(255,255,255,0.04); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-bottom: 0.2rem;">
            <i class="fas fa-shopping-cart" style="color: var(--neon-red); font-size: clamp(0.8rem, 1vw, 1.1rem);"></i>
            <span class="text-muted" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); text-transform: uppercase; letter-spacing: 0.5px;">Đã chi</span>
        </div>
        <div style="font-size: clamp(1rem, 1.5vw, 1.6rem); font-weight: 800; color: var(--neon-red);"><%= formatPrice(totalSpent) %></div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: clamp(0.6rem, 0.8vw, 1.2rem); border: 1px solid rgba(255,255,255,0.04); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-bottom: 0.2rem;">
            <i class="fas fa-money-bill-wave" style="color: var(--neon-cyan); font-size: clamp(0.8rem, 1vw, 1.1rem);"></i>
            <span class="text-muted" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); text-transform: uppercase; letter-spacing: 0.5px;">Đã rút</span>
        </div>
        <div style="font-size: clamp(1rem, 1.5vw, 1.6rem); font-weight: 800; color: var(--neon-cyan);"><%= user.withdraw_count || 0 %> lần</div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: clamp(0.6rem, 0.8vw, 1.2rem); border: 1px solid rgba(255,255,255,0.04); text-align: center;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-bottom: 0.2rem;">
            <i class="fas fa-chart-line" style="color: var(--neon-yellow); font-size: clamp(0.8rem, 1vw, 1.1rem);"></i>
            <span class="text-muted" style="font-size: clamp(0.4rem, 0.5vw, 0.6rem); text-transform: uppercase; letter-spacing: 0.5px;">Doanh thu</span>
        </div>
        <div style="font-size: clamp(1rem, 1.5vw, 1.6rem); font-weight: 800; color: var(--neon-yellow);"><%= formatPrice(totalEarned) %></div>
    </div>
</div>

<!-- Referral & Deposit -->
<div class="fade-up" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
            <i class="fas fa-gift" style="color: var(--neon-red); font-size: 0.9rem;"></i>
            <h3 style="font-size: 0.85rem; font-weight: 700; margin: 0;">Giới thiệu bạn bè</h3>
        </div>
        <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 100px; background: var(--bg-primary); padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid rgba(255,23,68,0.08);">
                <code style="font-size: 0.7rem; color: var(--neon-red); font-weight: 700; letter-spacing: 0.5px;"><%= user.referral_code %></code>
            </div>
            <button onclick="copyToClipboard('<%= user.referral_code %>', 'Mã giới thiệu')" class="btn btn-primary btn-sm" style="padding: 0.3rem 0.8rem; font-size: 0.65rem; border-radius: 6px; white-space: nowrap;">
                <i class="fas fa-copy"></i> Sao chép
            </button>
        </div>
        <p class="text-muted" style="font-size: 0.55rem; margin-top: 0.3rem; text-align: center;">
            <i class="fas fa-info-circle"></i> Mỗi bạn bè đăng ký, cả hai nhận <strong style="color: var(--neon-green);">5,000đ</strong>!
        </p>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius-sm); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
            <i class="fas fa-qrcode" style="color: var(--neon-cyan); font-size: 0.9rem;"></i>
            <h3 style="font-size: 0.85rem; font-weight: 700; margin: 0;">Mã nạp tiền</h3>
        </div>
        <div style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 100px; background: var(--bg-primary); padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid rgba(0,229,255,0.08);">
                <code style="font-size: 0.7rem; color: var(--neon-cyan); font-weight: 700; letter-spacing: 0.5px;"><%= user.deposit_code %></code>
            </div>
            <button onclick="copyToClipboard('<%= user.deposit_code %>', 'Mã nạp tiền')" class="btn btn-outline btn-sm" style="padding: 0.3rem 0.6rem; font-size: 0.65rem; border-radius: 6px; white-space: nowrap;">
                <i class="fas fa-copy"></i>
            </button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; margin-top: 0.4rem;">
            <a href="/deposit" class="btn btn-primary btn-sm" style="padding: 0.3rem; font-size: 0.65rem; border-radius: 6px; justify-content: center;">
                <i class="fas fa-plus-circle"></i> Nạp tiền
            </a>
            <% if (user.is_seller || user.is_admin) { %>
            <a href="/withdraw" class="btn btn-success btn-sm" style="padding: 0.3rem; font-size: 0.65rem; border-radius: 6px; justify-content: center;">
                <i class="fas fa-money-bill-wave"></i> Rút tiền
            </a>
            <% } %>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius-sm); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04); margin-bottom: 1rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-clock" style="color: var(--neon-cyan); font-size: 0.9rem;"></i>
            <h3 style="font-size: 0.85rem; font-weight: 700; margin: 0;">Hoạt động gần đây</h3>
        </div>
        <span class="badge badge-cyan" style="font-size: 0.4rem; padding: 0.05rem 0.5rem;">Mới nhất</span>
    </div>
    
    <% if (recentPurchases && recentPurchases.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 0.4rem; max-height: 280px; overflow-y: auto;">
            <% recentPurchases.forEach(function(p) { %>
            <div style="display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem; background: var(--bg-secondary); border-radius: 6px; border-left: 2px solid var(--neon-green);">
                <div style="width: 28px; height: 28px; border-radius: 6px; background: var(--bg-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <i class="fas fa-shopping-bag" style="color: var(--neon-green); font-size: 0.6rem;"></i>
                </div>
                <div style="flex: 1; min-width: 0;">
                    <div style="font-size: 0.7rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        <%= p.product_name || 'Đã xóa' %>
                    </div>
                    <div style="font-size: 0.5rem; color: var(--text-muted);">
                        <i class="fas fa-calendar"></i> <%= new Date(p.purchased_at).toLocaleDateString('vi-VN') %>
                    </div>
                </div>
                <div style="font-weight: 700; color: var(--neon-red); font-size: 0.7rem; white-space: nowrap;">
                    <%= formatPrice(p.amount_paid) %>
                </div>
            </div>
            <% }); %>
        </div>
    <% } else { %>
        <div style="text-align: center; padding: 1.2rem 0.5rem;">
            <i class="fas fa-inbox" style="font-size: 1.5rem; color: var(--text-muted); display: block; margin-bottom: 0.3rem;"></i>
            <p class="text-muted" style="font-size: 0.75rem;">Chưa có hoạt động nào</p>
            <a href="/" class="btn btn-primary btn-sm" style="margin-top: 0.3rem; padding: 0.25rem 0.8rem; font-size: 0.6rem; border-radius: 6px;">
                <i class="fas fa-store"></i> Khám phá ngay
            </a>
        </div>
    <% } %>
</div>

<!-- Admin Panel -->
<% if (user && user.is_admin) { %>
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius-sm); padding: 1rem 1.2rem; border: 1px solid rgba(255,23,68,0.1); margin-bottom: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
        <i class="fas fa-shield-alt" style="color: var(--neon-red); font-size: 0.9rem;"></i>
        <h3 style="font-size: 0.85rem; font-weight: 700; margin: 0; color: var(--neon-red);">Khu vực quản trị</h3>
        <span class="badge badge-red" style="font-size: 0.4rem; padding: 0.05rem 0.5rem; margin-left: auto;">Admin</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 0.4rem;">
        <a href="/admin/dashboard" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-chart-line"></i> Dashboard
        </a>
        <a href="/admin/users" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-users"></i> Người dùng
        </a>
        <a href="/admin/files" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-file"></i> Sản phẩm
        </a>
        <a href="/admin/deposits" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-qrcode"></i> Nạp tiền
        </a>
        <a href="/admin/withdraws" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-money-bill-wave"></i> Rút tiền
        </a>
        <a href="/admin/discounts" class="btn btn-primary btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-tags"></i> Mã giảm giá
        </a>
    </div>
</div>
<% } %>

<!-- Seller Panel -->
<% if (user && (user.is_seller || user.is_admin)) { %>
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius-sm); padding: 1rem 1.2rem; border: 1px solid rgba(255,234,0,0.08);">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
        <i class="fas fa-store" style="color: var(--neon-yellow); font-size: 0.9rem;"></i>
        <h3 style="font-size: 0.85rem; font-weight: 700; margin: 0; color: var(--neon-yellow);">Khu vực bán hàng</h3>
        <span class="badge badge-yellow" style="font-size: 0.4rem; padding: 0.05rem 0.5rem; margin-left: auto;">Seller</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.4rem;">
        <a href="/file/upload" class="btn btn-success btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-cloud-upload-alt"></i> Đăng bán
        </a>
        <a href="/file/my-files" class="btn btn-info btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-file"></i> SP của tôi
        </a>
        <a href="/withdraw" class="btn btn-gold btn-sm" style="padding: 0.25rem; font-size: 0.6rem; border-radius: 6px; justify-content: center;">
            <i class="fas fa-money-bill-wave"></i> Rút tiền
        </a>
    </div>
</div>
<% } %>