<%- include('base', { title: 'Quản lý sản phẩm' }) %>

<div class="fade-up" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #ff1744, #ff4081); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 40px rgba(255,23,68,0.15);">
            <i class="fas fa-file-alt" style="font-size: 1.8rem; color: white;"></i>
        </div>
        <div>
            <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0;">
                <span class="text-gradient" style="background: linear-gradient(135deg, #ff1744, #ff4081); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    Quản lý sản phẩm
                </span>
            </h1>
            <p class="text-muted" style="font-size: 0.85rem; margin: 0.2rem 0 0;">
                <i class="fas fa-cube" style="color: var(--neon-red);"></i> Quản lý tất cả sản phẩm trên hệ thống
            </p>
        </div>
    </div>
</div>

<div class="card">
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; min-width: 900px;">
            <thead>
                <tr style="background: var(--bg-primary); border-bottom: 2px solid rgba(255,23,68,0.1);">
                    <th style="padding: 1rem 0.8rem; text-align: center; width: 60px; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Ảnh</th>
                    <th style="padding: 1rem 0.8rem; text-align: left; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Sản phẩm</th>
                    <th style="padding: 1rem 0.8rem; text-align: left; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Danh mục</th>
                    <th style="padding: 1rem 0.8rem; text-align: left; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Người bán</th>
                    <th style="padding: 1rem 0.8rem; text-align: right; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Giá</th>
                    <th style="padding: 1rem 0.8rem; text-align: center; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Tải</th>
                    <th style="padding: 1rem 0.8rem; text-align: center; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Trạng thái</th>
                    <th style="padding: 1rem 0.8rem; text-align: center; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted);">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% files.forEach(function(file) { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.03); transition: var(--transition);"
                    onmouseenter="this.style.background='rgba(255,255,255,0.01)'"
                    onmouseleave="this.style.background='transparent'">
                    <td style="padding: 1rem 0.8rem; text-align: center;">
                        <% if (file.thumbnail) { %>
                            <img src="/file/thumbnail/<%= file.thumbnail %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: 10px; border: 1px solid var(--border-color);">
                        <% } else { %>
                            <div style="width: 48px; height: 48px; border-radius: 10px; background: var(--bg-secondary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
                                <i class="fas fa-file" style="color: var(--text-muted); font-size: 1.2rem;"></i>
                            </div>
                        <% } %>
                    </td>
                    <td style="padding: 1rem 0.8rem;">
                        <div>
                            <strong style="font-size: 0.9rem; color: var(--text-primary);"><%= file.product_name %></strong>
                            <br><small class="text-muted" style="font-size: 0.6rem;"><i class="fas fa-file"></i> <%= file.original_name ? file.original_name.substring(0, 25) : '' %></small>
                        </div>
                    </td>
                    <td style="padding: 1rem 0.8rem;">
                        <% if (file.category === 'mod_nut') { %>
                            <span class="badge badge-red" style="font-size: 0.55rem;"><i class="fas fa-gamepad"></i> MOD NÚT</span>
                        <% } else if (file.category === 'mod_trang_phuc') { %>
                            <span class="badge badge-blue" style="font-size: 0.55rem;"><i class="fas fa-tshirt"></i> MOD TRANG PHỤC</span>
                        <% } else if (file.category === 'tool_aov') { %>
                            <span class="badge badge-green" style="font-size: 0.55rem;"><i class="fas fa-tools"></i> TOOL AOV</span>
                        <% } else if (file.category === 'mod_thong_bao') { %>
                            <span class="badge badge-cyan" style="font-size: 0.55rem;"><i class="fas fa-bell"></i> MOD THÔNG BÁO</span>
                        <% } else { %>
                            <span class="text-muted" style="font-size: 0.6rem;"><%= file.category || 'Khác' %></span>
                        <% } %>
                    </td>
                    <td style="padding: 1rem 0.8rem;">
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">
                            <i class="fas fa-user-circle"></i> <%= file.seller_username || 'Admin' %>
                        </span>
                    </td>
                    <td style="padding: 1rem 0.8rem; text-align: right;">
                        <span style="font-weight: 700; font-size: 0.95rem; color: var(--neon-red);"><%= formatPrice(file.price) %></span>
                    </td>
                    <td style="padding: 1rem 0.8rem; text-align: center;">
                        <span style="background: var(--bg-primary); padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.7rem; color: var(--text-secondary);">
                            <%= file.download_count || 0 %>
                        </span>
                    </td>
                    <td style="padding: 1rem 0.8rem; text-align: center;">
                        <% if (file.is_active) { %>
                            <span style="color: var(--neon-green); font-size: 0.75rem; font-weight: 600;">
                                <i class="fas fa-check-circle"></i> Đang bán
                            </span>
                        <% } else { %>
                            <span style="color: var(--neon-red); font-size: 0.75rem; font-weight: 600;">
                                <i class="fas fa-ban"></i> Đã ẩn
                            </span>
                        <% } %>
                    </td>
                    <td style="padding: 1rem 0.8rem; text-align: center;">
                        <div style="display: flex; gap: 0.3rem; justify-content: center; flex-wrap: wrap;">
                            <form method="POST" action="/admin/files/<%= file.id %>/toggle" style="display: inline;">
                                <button type="submit" class="btn btn-sm" style="padding: 0.25rem 0.6rem; font-size: 0.6rem; border-radius: 6px; background: <% if (file.is_active) { %>var(--neon-yellow); color: #1a1a1a;<% } else { %>var(--neon-green); color: white;<% } %> border: none; cursor: pointer;">
                                    <i class="fas <% if (file.is_active) { %>fa-eye-slash<% } else { %>fa-eye<% } %>"></i>
                                    <% if (file.is_active) { %>Ẩn<% } else { %>Hiện<% } %>
                                </button>
                            </form>
                            <form method="POST" action="/admin/files/<%= file.id %>/delete" style="display: inline;" 
                                  onsubmit="return confirm('❌ Bạn có chắc muốn xóa sản phẩm <%= file.product_name %>?')">
                                <button type="submit" class="btn btn-danger btn-sm" style="padding: 0.25rem 0.6rem; font-size: 0.6rem; border-radius: 6px;">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>