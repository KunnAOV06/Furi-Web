<%- include('base', { title: 'Quản lý khuyến mãi' }) %>

<div class="fade-up" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #ffea00, #ff9100); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 40px rgba(255,234,0,0.15);">
            <i class="fas fa-percent" style="font-size: 1.8rem; color: #1a1a1a;"></i>
        </div>
        <div>
            <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0;">
                <span class="text-gradient" style="background: linear-gradient(135deg, #ffea00, #ff9100); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                    Quản lý khuyến mãi
                </span>
            </h1>
            <p class="text-muted" style="font-size: 0.85rem; margin: 0.2rem 0 0;">
                <i class="fas fa-tags" style="color: var(--neon-yellow);"></i> 
                Quản lý tất cả chương trình giảm giá
            </p>
        </div>
    </div>
</div>

<!-- Banner -->
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.04); box-shadow: var(--shadow-premium); overflow: hidden; margin-bottom: 1.5rem;">
    <div style="background: linear-gradient(135deg, rgba(0,229,255,0.04), rgba(41,121,255,0.04)); padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(0,229,255,0.12); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-bell" style="color: var(--neon-cyan); font-size: 0.9rem;"></i>
            </div>
            <h3 style="font-size: 1rem; font-weight: 700; margin: 0; color: var(--text-primary);">Thông báo chào mừng</h3>
        </div>
    </div>
    <form method="POST" action="/admin/welcome-banner" style="padding: 1.5rem;">
        <div style="margin-bottom: 0.8rem;">
            <label style="font-weight: 600; color: var(--text-secondary); font-size: 0.8rem; display: block; margin-bottom: 0.3rem;">
                <i class="fas fa-edit" style="color: var(--neon-cyan);"></i> Nội dung thông báo
            </label>
            <textarea name="content" rows="3" placeholder="Nhập nội dung thông báo chào mừng..." 
                      style="width: 100%; padding: 0.8rem 1rem; background: var(--bg-primary); border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9rem; resize: vertical;"><%= bannerContent || '🎉 Chào mừng bạn đến với FURI WEB! Mua sắm an toàn, chất lượng cao!' %></textarea>
        </div>
        <button type="submit" class="btn btn-info btn-sm" style="padding: 0.6rem 1.5rem; font-size: 0.85rem;">
            <i class="fas fa-save"></i> Cập nhật thông báo
        </button>
    </form>
</div>

<!-- Global Sale -->
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.04); box-shadow: var(--shadow-premium); overflow: hidden; margin-bottom: 1.5rem;">
    <div style="background: linear-gradient(135deg, rgba(255,234,0,0.04), rgba(255,145,0,0.04)); padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(255,234,0,0.12); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-percent" style="color: var(--neon-yellow); font-size: 0.9rem;"></i>
            </div>
            <h3 style="font-size: 1rem; font-weight: 700; margin: 0; color: var(--text-primary);">Sale toàn bộ sản phẩm</h3>
        </div>
    </div>
    <form method="POST" action="/admin/sale-settings" style="padding: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
            <div>
                <label style="font-weight: 600; color: var(--text-secondary); font-size: 0.8rem; display: block; margin-bottom: 0.3rem;">
                    <i class="fas fa-check-circle" style="color: var(--neon-green);"></i> Kích hoạt sale
                </label>
                <div style="display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 1rem; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <input type="checkbox" name="global_sale" id="globalSale" <% if (globalSale && globalSale.is_active) { %>checked<% } %> style="width: 18px; height: 18px; accent-color: var(--neon-green); cursor: pointer;">
                    <label for="globalSale" style="margin: 0; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer;">
                        <% if (globalSale && globalSale.is_active) { %>Đang giảm giá toàn bộ<% } else { %>Bật giảm giá toàn bộ<% } %>
                    </label>
                </div>
            </div>
            <div>
                <label style="font-weight: 600; color: var(--text-secondary); font-size: 0.8rem; display: block; margin-bottom: 0.3rem;">
                    <i class="fas fa-percent" style="color: var(--neon-yellow);"></i> Phần trăm giảm
                </label>
                <div style="position: relative;">
                    <input type="number" name="global_discount" step="1" min="0" max="100" 
                           value="<%= globalSale && globalSale.discount_percent ? globalSale.discount_percent : 0 %>" placeholder="VD: 20"
                           style="width: 100%; padding: 0.7rem 1rem; background: var(--bg-primary); border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9rem;">
                    <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-weight: 700; font-size: 0.8rem;">%</span>
                </div>
            </div>
            <div>
                <label style="font-weight: 600; color: var(--text-secondary); font-size: 0.8rem; display: block; margin-bottom: 0.3rem;">
                    <i class="fas fa-calendar" style="color: var(--neon-cyan);"></i> Số ngày áp dụng
                </label>
                <input type="number" name="sale_days" step="1" min="1" value="7" placeholder="7"
                       style="width: 100%; padding: 0.7rem 1rem; background: var(--bg-primary); border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.9rem;">
            </div>
        </div>
        <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 1rem; padding: 0.8rem; font-size: 0.95rem; border-radius: var(--radius-sm);">
            <i class="fas fa-save"></i> Cập nhật sale toàn bộ
        </button>
    </form>
</div>

<!-- Product Sale -->
<div class="fade-up" style="background: var(--bg-card); border-radius: var(--radius); border: 1px solid rgba(255,255,255,0.04); box-shadow: var(--shadow-premium); overflow: hidden;">
    <div style="background: linear-gradient(135deg, rgba(139,92,246,0.04), rgba(41,121,255,0.04)); padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 36px; height: 36px; border-radius: 10px; background: rgba(139,92,246,0.12); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-tag" style="color: var(--neon-purple); font-size: 0.9rem;"></i>
            </div>
            <h3 style="font-size: 1rem; font-weight: 700; margin: 0; color: var(--text-primary);">Sale riêng từng sản phẩm</h3>
        </div>
    </div>
    <div style="padding: 1.5rem; overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; min-width: 600px;">
            <thead>
                <tr style="background: var(--bg-primary); border-bottom: 2px solid rgba(139,92,246,0.1);">
                    <th style="padding: 0.8rem 0.6rem; text-align: left;">Sản phẩm</th>
                    <th style="padding: 0.8rem 0.6rem; text-align: right;">Giá gốc</th>
                    <th style="padding: 0.8rem 0.6rem; text-align: center;">Giảm</th>
                    <th style="padding: 0.8rem 0.6rem; text-align: center;">Hết hạn</th>
                    <th style="padding: 0.8rem 0.6rem; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% files.forEach(function(file) { 
                    var sale = productSales.find(s => s.file_id === file.id);
                %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                    <td style="padding: 0.8rem 0.6rem;">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <% if (file.thumbnail) { %>
                                <img src="/file/thumbnail/<%= file.thumbnail %>" style="width: 36px; height: 36px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color);">
                            <% } else { %>
                                <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--bg-secondary); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
                                    <i class="fas fa-file" style="color: var(--text-muted); font-size: 0.8rem;"></i>
                                </div>
                            <% } %>
                            <div>
                                <strong style="font-size: 0.85rem; color: var(--text-primary);"><%= file.product_name %></strong>
                                <% if (sale && sale.is_active) { %>
                                    <br><span class="badge badge-red" style="font-size: 0.4rem; padding: 0.1rem 0.5rem;"><i class="fas fa-fire"></i> SALE</span>
                                <% } %>
                            </div>
                        </div>
                    </td>
                    <td style="padding: 0.8rem 0.6rem; text-align: right;">
                        <span style="font-weight: 600; color: var(--text-secondary); font-size: 0.85rem;"><%= formatPrice(file.price) %></span>
                    </td>
                    <td style="padding: 0.8rem 0.6rem; text-align: center;">
                        <% if (sale && sale.is_active) { %>
                            <span style="color: var(--neon-red); font-weight: 700; font-size: 1rem;">-<%= sale.discount_percent %>%</span>
                        <% } else { %>
                            <span class="text-muted" style="font-size: 0.8rem;">0%</span>
                        <% } %>
                    </td>
                    <td style="padding: 0.8rem 0.6rem; text-align: center;">
                        <% if (sale && sale.is_active && sale.end_date) { %>
                            <span style="font-size: 0.7rem; color: var(--neon-cyan);">
                                <i class="fas fa-calendar"></i> <%= new Date(sale.end_date).toLocaleDateString('vi-VN') %>
                            </span>
                        <% } else { %>
                            <span class="text-muted" style="font-size: 0.7rem;">—</span>
                        <% } %>
                    </td>
                    <td style="padding: 0.8rem 0.6rem; text-align: center;">
                        <form method="POST" action="/admin/product-sale/<%= file.id %>" style="display: flex; gap: 0.3rem; justify-content: center; flex-wrap: wrap;">
                            <input type="number" name="discount" step="1" min="0" max="100" 
                                   placeholder="%" value="<%= sale && sale.discount_percent ? sale.discount_percent : 0 %>"
                                   style="width: 60px; padding: 0.2rem 0.3rem; font-size: 0.7rem; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); text-align: center;">
                            <input type="number" name="days" step="1" min="0" placeholder="Ngày"
                                   style="width: 60px; padding: 0.2rem 0.3rem; font-size: 0.7rem; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); text-align: center;">
                            <button type="submit" class="btn btn-sm" style="padding: 0.2rem 0.6rem; font-size: 0.6rem; border-radius: 6px; background: var(--gradient-main); color: white; border: none; cursor: pointer;">
                                <i class="fas fa-check"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>