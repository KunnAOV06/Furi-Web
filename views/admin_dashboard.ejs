<%- include('base', { title: 'Bảng điều khiển' }) %>

<!-- Header -->
<div class="fade-up" style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #8b5cf6, #2979ff); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 40px rgba(139,92,246,0.15);">
                <i class="fas fa-chart-pie" style="font-size: 1.8rem; color: white;"></i>
            </div>
            <div>
                <h1 style="font-size: 1.6rem; font-weight: 800; margin: 0;">
                    <span class="text-gradient" style="background: linear-gradient(135deg, #8b5cf6, #2979ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                        Bảng điều khiển
                    </span>
                </h1>
                <p class="text-muted" style="font-size: 0.85rem; margin: 0.2rem 0 0;">
                    <i class="fas fa-eye" style="color: var(--neon-purple);"></i> Tổng quan hoạt động hệ thống
                </p>
            </div>
        </div>
        
        <div style="display: flex; align-items: center; gap: 0.6rem; background: var(--bg-secondary); padding: 0.5rem 1.2rem; border-radius: var(--radius-full); border: 1px solid rgba(255,255,255,0.04);">
            <i class="fas fa-clock" style="color: var(--neon-cyan); font-size: 0.7rem;"></i>
            <span style="color: var(--text-secondary); font-size: 0.75rem;" id="currentTime">Đang tải...</span>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="fade-up" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(16,185,129,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(16,185,129,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16,185,129,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-dollar-sign" style="color: var(--neon-green); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Doanh thu</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-green);"><%= formatPrice(totalRevenue) %></div>
            </div>
        </div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(41,121,255,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(41,121,255,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(41,121,255,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-users" style="color: var(--neon-blue); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Người dùng</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-blue);"><%= totalUsers %></div>
            </div>
        </div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(255,23,68,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(255,23,68,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,23,68,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-file" style="color: var(--neon-red); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Sản phẩm</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-red);"><%= totalFiles %></div>
            </div>
        </div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(0,229,255,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(0,229,255,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0,229,255,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-download" style="color: var(--neon-cyan); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Lượt tải</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-cyan);"><%= totalDownloads %></div>
            </div>
        </div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(255,234,0,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(255,234,0,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,234,0,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-qrcode" style="color: var(--neon-yellow); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Nạp chờ</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-yellow);"><%= pendingDeposits %></div>
            </div>
        </div>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.2rem 1rem; border: 1px solid rgba(255,255,255,0.04); transition: var(--transition); position: relative; overflow: hidden;"
         onmouseenter="this.style.borderColor='rgba(255,64,129,0.3)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-premium)'"
         onmouseleave="this.style.borderColor='rgba(255,255,255,0.04)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        <div style="position: absolute; top: -50%; right: -20%; width: 60%; height: 200%; background: radial-gradient(ellipse, rgba(255,64,129,0.05), transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; display: flex; align-items: center; gap: 0.8rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255,64,129,0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="fas fa-money-bill-wave" style="color: var(--neon-pink); font-size: 1.2rem;"></i>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.5px;">Rút chờ</div>
                <div style="font-size: 1.3rem; font-weight: 800; color: var(--neon-pink);"><%= pendingWithdraws %></div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions & Recent Transactions -->
<div class="fade-up" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    
    <!-- Quick Actions -->
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.5rem; border: 1px solid rgba(255,255,255,0.04); box-shadow: var(--shadow-card);">
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(139,92,246,0.12); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-bolt" style="color: var(--neon-purple); font-size: 0.8rem;"></i>
            </div>
            <h3 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-primary);">Thao tác nhanh</h3>
            <span class="badge badge-purple" style="font-size: 0.4rem; padding: 0.05rem 0.5rem; margin-left: auto;">6</span>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <a href="/admin/users" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-users" style="font-size: 0.7rem;"></i> Người dùng
            </a>
            <a href="/admin/files" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-file" style="font-size: 0.7rem;"></i> Sản phẩm
            </a>
            <a href="/admin/deposits" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-qrcode" style="font-size: 0.7rem;"></i> Nạp tiền
            </a>
            <a href="/admin/withdraws" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-money-bill-wave" style="font-size: 0.7rem;"></i> Rút tiền
            </a>
            <a href="/admin/discounts" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-tags" style="font-size: 0.7rem;"></i> Mã giảm giá
            </a>
            <a href="/admin/sale-settings" class="btn btn-primary btn-sm" style="padding: 0.5rem; font-size: 0.7rem; border-radius: 8px; justify-content: center; gap: 0.3rem;">
                <i class="fas fa-percent" style="font-size: 0.7rem;"></i> Quản lý sale
            </a>
        </div>
        
        <div style="margin-top: 1rem; padding: 0.6rem 0.8rem; background: var(--bg-secondary); border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.04);">
            <div style="display: flex; justify-content: space-between; font-size: 0.7rem; padding: 0.15rem 0;">
                <span class="text-muted"><i class="fas fa-cube"></i> Hoa hồng</span>
                <span><strong style="color: var(--neon-green);">80%</strong> <span class="text-muted">/</span> <strong style="color: var(--neon-red);">20%</strong></span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.7rem; padding: 0.15rem 0; border-top: 1px solid rgba(255,255,255,0.03);">
                <span class="text-muted"><i class="fas fa-money-bill-wave"></i> Rút tối thiểu</span>
                <span><strong style="color: var(--neon-cyan);"><%= formatPrice(10000) %></strong></span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.7rem; padding: 0.15rem 0; border-top: 1px solid rgba(255,255,255,0.03);">
                <span class="text-muted"><i class="fas fa-gift"></i> Miễn phí rút</span>
                <span><strong style="color: var(--neon-yellow);">5 lần đầu</strong></span>
            </div>
        </div>
    </div>
    
    <!-- Recent Transactions -->
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1.5rem; border: 1px solid rgba(255,255,255,0.04); box-shadow: var(--shadow-card);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(0,229,255,0.12); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-clock" style="color: var(--neon-cyan); font-size: 0.8rem;"></i>
                </div>
                <h3 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-primary);">Giao dịch gần đây</h3>
            </div>
            <span class="badge badge-cyan" style="font-size: 0.4rem; padding: 0.05rem 0.5rem;"><%= recentPurchases.length %></span>
        </div>
        
        <% if (recentPurchases && recentPurchases.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0.4rem; max-height: 320px; overflow-y: auto; padding-right: 0.3rem;">
                <% recentPurchases.slice(0, 5).forEach(function(p) { %>
                <div style="display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem; background: var(--bg-secondary); border-radius: var(--radius-sm); border-left: 2px solid var(--neon-green); transition: var(--transition);"
                     onmouseenter="this.style.background='rgba(255,255,255,0.02)'">
                    <div style="width: 28px; height: 28px; border-radius: 6px; background: var(--bg-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i class="fas fa-shopping-bag" style="color: var(--neon-green); font-size: 0.6rem;"></i>
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-size: 0.7rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <%= p.username || 'User' %> 
                            <span class="text-muted" style="font-size: 0.55rem;">
                                <i class="fas fa-arrow-right"></i> <%= p.product_name || 'Đã xóa' %>
                            </span>
                        </div>
                        <div style="font-size: 0.5rem; color: var(--text-muted);">
                            <i class="fas fa-calendar"></i> <%= new Date(p.purchased_at).toLocaleDateString('vi-VN') %>
                        </div>
                    </div>
                    <div style="font-weight: 700; color: var(--neon-red); font-size: 0.7rem; white-space: nowrap;">
                        <%= formatPrice(p.amount_paid) %>
                    </div>
                </div>
                <% }); %>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 2rem 1rem;">
                <i class="fas fa-inbox" style="font-size: 2rem; color: var(--text-muted); display: block; margin-bottom: 0.3rem;"></i>
                <p class="text-muted" style="font-size: 0.75rem;">Chưa có giao dịch nào</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Bottom: Top Seller, Hot Products, System Status -->
<div class="fade-up" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
            <i class="fas fa-trophy" style="color: var(--neon-yellow); font-size: 0.9rem;"></i>
            <h4 style="font-size: 0.75rem; font-weight: 700; margin: 0; color: var(--text-secondary);">🏆 Top người bán</h4>
        </div>
        <% if (sellers && sellers.length > 0) { %>
            <% sellers.slice(0, 3).forEach(function(seller, index) { %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0; border-bottom: 1px solid rgba(255,255,255,0.03);">
                <span style="font-size: 0.7rem; color: var(--text-secondary);">
                    <span style="color: <% if (index === 0) { %>var(--neon-yellow)<% } else if (index === 1) { %>var(--neon-cyan)<% } else { %>var(--neon-orange)<% } %>;">
                        <%= ['🥇', '🥈', '🥉'][index] %>
                    </span>
                    <%= seller.username %>
                </span>
                <span style="font-size: 0.7rem; font-weight: 600; color: var(--neon-green);"><%= formatPrice(seller.total_sales || 0) %></span>
            </div>
            <% }); %>
        <% } else { %>
            <p class="text-muted" style="font-size: 0.65rem; text-align: center;">Chưa có người bán</p>
        <% } %>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
            <i class="fas fa-fire" style="color: var(--neon-red); font-size: 0.9rem;"></i>
            <h4 style="font-size: 0.75rem; font-weight: 700; margin: 0; color: var(--text-secondary);">🔥 Sản phẩm hot</h4>
        </div>
        <% if (files && files.length > 0) { %>
            <% files.sort((a, b) => (b.download_count || 0) - (a.download_count || 0)).slice(0, 3).forEach(function(file) { %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.3rem 0; border-bottom: 1px solid rgba(255,255,255,0.03);">
                <span style="font-size: 0.7rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;">
                    <%= file.product_name %>
                </span>
                <span style="font-size: 0.7rem; font-weight: 600; color: var(--neon-cyan);">
                    <i class="fas fa-download"></i> <%= file.download_count || 0 %>
                </span>
            </div>
            <% }); %>
        <% } else { %>
            <p class="text-muted" style="font-size: 0.65rem; text-align: center;">Chưa có sản phẩm</p>
        <% } %>
    </div>
    
    <div style="background: var(--bg-card); border-radius: var(--radius); padding: 1rem 1.2rem; border: 1px solid rgba(255,255,255,0.04);">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
            <i class="fas fa-server" style="color: var(--neon-green); font-size: 0.9rem;"></i>
            <h4 style="font-size: 0.75rem; font-weight: 700; margin: 0; color: var(--text-secondary);">🟢 Trạng thái hệ thống</h4>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.2rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.65rem; padding: 0.15rem 0;">
                <span class="text-muted"><i class="fas fa-circle" style="color: var(--neon-green); font-size: 0.4rem;"></i> Máy chủ</span>
                <span style="color: var(--neon-green); font-weight: 600;">Hoạt động</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.65rem; padding: 0.15rem 0; border-top: 1px solid rgba(255,255,255,0.03);">
                <span class="text-muted"><i class="fas fa-database"></i> Database</span>
                <span style="color: var(--neon-green); font-weight: 600;">Kết nối</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.65rem; padding: 0.15rem 0; border-top: 1px solid rgba(255,255,255,0.03);">
                <span class="text-muted"><i class="fas fa-clock"></i> Phiên bản</span>
                <span style="color: var(--neon-cyan); font-weight: 600;">v4.0</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.65rem; padding: 0.15rem 0; border-top: 1px solid rgba(255,255,255,0.03);">
                <span class="text-muted"><i class="fas fa-users"></i> Online</span>
                <span style="color: var(--neon-yellow); font-weight: 600;"><%= totalUsers %> users</span>
            </div>
        </div>
    </div>
</div>

<script>
    function updateClock() {
        const now = new Date();
        const options = { 
            weekday: 'short', 
            day: '2-digit', 
            month: '2-digit', 
            year: 'numeric',
            hour: '2-digit', 
            minute: '2-digit', 
            second: '2-digit',
            hour12: false
        };
        document.getElementById('currentTime').textContent = now.toLocaleDateString('vi-VN', options);
    }
    updateClock();
    setInterval(updateClock, 1000);
</script>