<%- include('base', { title: 'Quên mật khẩu' }) %>

<div class="fade-up" style="max-width: 460px; margin: 1.5rem auto;">
    <div class="card-glow" style="padding: 2rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="display: inline-block; padding: 1rem; background: var(--gradient-glow); border-radius: 50%; margin-bottom: 0.8rem;">
                <i class="fas fa-key" style="font-size: 2rem; background: var(--gradient-main); -webkit-background-clip: text; background-clip: text; color: transparent;"></i>
            </div>
            <h2 style="font-size: 1.6rem; font-weight: 700;">Quên mật khẩu?</h2>
            <p class="text-muted" style="font-size: 0.85rem;">
                Nhập email của bạn để nhận mã xác minh
            </p>
        </div>
        
        <form method="POST" action="/auth/forgot-password">
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.4rem;">
                    <i class="fas fa-envelope" style="color: var(--neon-cyan);"></i> Địa chỉ Email
                </label>
                <input type="email" name="email" placeholder="example@email.com" required
                       style="width: 100%; padding: 0.8rem 1rem; background: var(--bg-primary); border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 0.95rem;">
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.8rem; font-size: 1rem;">
                <i class="fas fa-paper-plane"></i> Gửi mã xác minh
            </button>
        </form>
        
        <div style="text-align: center; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <a href="/auth/login" style="color: var(--neon-cyan); text-decoration: none; font-size: 0.85rem;">
                <i class="fas fa-arrow-left"></i> Quay lại đăng nhập
            </a>
        </div>
        
        <div style="margin-top: 1rem; padding: 0.8rem; background: rgba(0,229,255,0.04); border-radius: var(--radius-sm); border-left: 3px solid var(--neon-cyan);">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-info-circle" style="color: var(--neon-cyan); font-size: 0.8rem;"></i>
                <span style="font-size: 0.7rem; color: var(--text-muted);">
                    Mã xác minh sẽ được gửi đến email của bạn, có hiệu lực trong <strong style="color: var(--neon-cyan);">5 phút</strong>
                </span>
            </div>
        </div>
    </div>
</div>