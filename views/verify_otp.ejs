<%- include('base', { title: 'Xác minh OTP' }) %>

<div class="fade-up" style="max-width: 460px; margin: 1.5rem auto;">
    <div class="card-glow" style="padding: 2rem;">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="display: inline-block; padding: 1rem; background: var(--gradient-glow); border-radius: 50%; margin-bottom: 0.8rem;">
                <i class="fas fa-shield-alt" style="font-size: 2rem; background: var(--gradient-main); -webkit-background-clip: text; background-clip: text; color: transparent;"></i>
            </div>
            <h2 style="font-size: 1.6rem; font-weight: 700;">Xác minh mã OTP</h2>
            <p class="text-muted" style="font-size: 0.85rem;">
                Nhập mã 6 chữ số đã được gửi đến <strong style="color: var(--neon-cyan);"><%= email %></strong>
            </p>
        </div>
        
        <form method="POST" action="/auth/verify-otp">
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.4rem;">
                    <i class="fas fa-hashtag" style="color: var(--neon-yellow);"></i> Mã xác minh
                </label>
                <div style="display: flex; gap: 0.5rem; justify-content: center;">
                    <input type="text" name="otp_code" placeholder="000000" required maxlength="6" autofocus
                           style="width: 100%; padding: 0.8rem 1rem; background: var(--bg-primary); border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 1.2rem; text-align: center; letter-spacing: 8px;"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,6)">
                </div>
                <div style="display: flex; justify-content: space-between; margin-top: 0.3rem;">
                    <span class="text-muted" style="font-size: 0.65rem;">
                        <i class="fas fa-clock"></i> Có hiệu lực 5 phút
                    </span>
                    <span id="timer" style="font-size: 0.7rem; color: var(--neon-red); font-weight: 600;">05:00</span>
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.8rem; font-size: 1rem;">
                <i class="fas fa-check-circle"></i> Xác minh
            </button>
        </form>
        
        <div style="text-align: center; margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
            <p class="text-muted" style="font-size: 0.8rem;">
                Chưa nhận được mã? 
                <button type="button" onclick="resendOTP()" style="background: none; border: none; color: var(--neon-cyan); cursor: pointer; font-weight: 600; font-size: 0.8rem; text-decoration: underline;">
                    Gửi lại
                </button>
            </p>
            <a href="/auth/forgot-password" style="color: var(--text-muted); text-decoration: none; font-size: 0.75rem;">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>

<script>
    // Timer 5 phút
    let timeLeft = 300;
    const timerEl = document.getElementById('timer');
    
    function updateTimer() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        timerEl.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
        
        if (timeLeft <= 60) {
            timerEl.style.color = 'var(--neon-red)';
        }
        
        if (timeLeft <= 0) {
            timerEl.textContent = '⏰ Hết hạn';
            timerEl.style.color = 'var(--neon-red)';
            document.querySelector('button[type="submit"]').disabled = true;
            document.querySelector('button[type="submit"]').style.opacity = '0.5';
            document.querySelector('button[type="submit"]').style.cursor = 'not-allowed';
        } else {
            timeLeft--;
        }
    }
    
    setInterval(updateTimer, 1000);
    
    function resendOTP() {
        const btn = event.target;
        const originalText = btn.textContent;
        btn.textContent = '🔄 Đang gửi...';
        btn.disabled = true;
        
        fetch('/auth/resend-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert('✅ ' + data.message);
                timeLeft = 300;
                document.querySelector('button[type="submit"]').disabled = false;
                document.querySelector('button[type="submit"]').style.opacity = '1';
                document.querySelector('button[type="submit"]').style.cursor = 'pointer';
                timerEl.style.color = 'var(--neon-red)';
            } else {
                alert('❌ ' + data.message);
            }
        })
        .catch(() => {
            alert('❌ Lỗi kết nối, vui lòng thử lại');
        })
        .finally(() => {
            btn.textContent = originalText;
            btn.disabled = false;
        });
    }
</script>