// api/index.js
const express = require('express');
const app = express();

app.get('/', (req, res) => {
    res.json({ message: 'FURI WEB API is running!' });
});

app.get('/api/welcome-banner', (req, res) => {
    res.json({ content: '🎉 Chào mừng đến với FURI WEB!', active: true });
});

module.exports = app;
